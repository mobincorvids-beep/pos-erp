PORT=4000
MONGO_URI=mongodb://localhost:27017/pos_erp
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1h
# Access tokens are short-lived on purpose — a refresh token (30 days,
# hashed at rest, single-use/rotating) covers the rest of a session. See
# src/services/refreshTokenService.js.
# Comma-separated list of allowed browser origins for CORS — the deployed
# client's URL(s) in production. Defaults to the local Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# JazzCash Mobile Wallet (MWALLET) — Pakistani payment gateway used from
# POS checkout. See src/services/paymentGateways/jazzCashService.js.
# All three values come from JazzCash's merchant onboarding portal
# (https://sandbox.jazzcash.com.pk for sandbox credentials, or your live
# merchant dashboard once approved) — under Integration / API Credentials.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# 'true' (default) hits JazzCash's sandbox host; set to 'false' only once
# live merchant credentials are configured, to hit their production host.
JAZZCASH_SANDBOX=true

# Easypaisa (Telenor Microfinance Bank) Open API — Mobile Account (MA)
# transactions. See src/services/paymentGateways/easypaisaService.js.
# All three values come from the Easypaisa/TMB merchant onboarding team
# during Open API integration setup.
EASYPAISA_STORE_ID=
EASYPAISA_MERCHANT_ID=
EASYPAISA_HASH_KEY=
# 'true' (default) hits Easypaisa's staging host; set to 'false' only once
# live merchant credentials are configured, to hit their production host.
EASYPAISA_SANDBOX=true

# Google OAuth / SSO login ("Sign in with Google" on the login page). All
# three optional — leave unset and the feature simply doesn't appear
# (no crash, no error). See src/config/passport.js for full setup notes.
# Get GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from Google Cloud Console
# (console.cloud.google.com -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Web application), after configuring
# the OAuth consent screen. GOOGLE_CALLBACK_URL must be added there under
# "Authorized redirect URIs" and must exactly match this app's deployed
# callback path, e.g. https://api.yourapp.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Microsoft/Azure AD SSO is not implemented yet, but the backend
# (src/config/passport.js, src/services/oauthService.js,
# src/routes/oauthRoutes.js) is structured so it can be added the same
# way Google was, gated behind MICROSOFT_CLIENT_ID/MICROSOFT_CLIENT_SECRET/
# MICROSOFT_CALLBACK_URL.

# Outgoing email (verification codes, notifications) — see
# src/services/emailService.js. All optional — leave unset and the app
# doesn't crash, it just logs emails to the server console instead of
# sending them (fine for local dev, not fine for a real deployment: nobody
# can actually complete signup without a real code in their inbox).
#
# FREE OPTION — a normal Gmail account, using an "App Password" (NOT your
# regular Gmail password, Google blocks that for security):
#   1. Go to https://myaccount.google.com/security
#   2. Turn on "2-Step Verification" if it isn't on already (required
#      before Google will let you create an App Password).
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Under "App name" type something like "ZAM ERP" and click Create.
#   5. Google shows you a 16-character password (like "abcd efgh ijkl
#      mnop") — copy it. This is what goes in SMTP_PASS below, not your
#      normal Gmail password.
#   6. Fill in the values below:
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=587
#        SMTP_USER=youraddress@gmail.com
#        SMTP_PASS=abcdefghijklmnop        (the App Password, no spaces)
#        SMTP_FROM=youraddress@gmail.com
#   Gmail's free tier caps outgoing mail at roughly 500/day, which is
#   plenty for verification codes on a small/medium app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
